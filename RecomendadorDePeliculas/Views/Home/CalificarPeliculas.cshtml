@model IEnumerable<RecomendadorDePeliculas.Entidades.Models.Pelicula>


<div class="container mt-3 mb-4 text-end">
    <a class="btn btn-outline-primary" asp-action="Historial" asp-controller="Home">Ver mi historial</a>
    <a href="@Url.Action("Generos", "Home")" class="btn btn-outline-primary">
        Modificar géneros favoritos
    </a>
</div>

<div class="container mt-4">

    <form method="get" asp-action="BuscarPeliculas" asp-controller="Home" class="mb-4">
        <div class="input-group">
            <input type="text" name="titulo" class="form-control" placeholder="Buscar película por título..." />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </div>
    </form>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center mt-4" role="alert">
            No se encontraron películas con ese nombre.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var pelicula in Model)
            {
            <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="row g-0">
                            <div class="col-md-4"></div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">@pelicula.Title</h5>
                                    <p class="card-text"><strong>Géneros:</strong> @pelicula.Genres</p>
                                    <p class="card-text"><strong>ID Interno:</strong> @pelicula.Id</p>
                                    <p class="card-text"><strong>TMDB ID:</strong> @pelicula.TmdbId</p>
                                    <button class="btn btn-sm fw-semibold text-white mt-2"
                                            style="background-color: #f7af07; border-radius: 6px; transition: background-color 0.3s ease;"
                                            onmouseover="this.style.backgroundColor='#e6a841'"
                                            onmouseout="this.style.backgroundColor='#ffb84d'"
                                            onclick="obtenerRecomendacion(@pelicula.Id,'@pelicula.Title','@pelicula.Genres')">
                                        ¿Es para mí?
                                    </button>

                                    <a asp-controller="Home"
                                       asp-action="Resenar"
                                       asp-route-id="@pelicula.Id"
                                       class="btn btn-sm fw-semibold text-white mt-2"
                                       style="background-color: #ff6b00; border-radius: 6px; transition: background-color 0.3s ease;"
                                       onmouseover="this.style.backgroundColor='#e65c00'"
                                       onmouseout="this.style.backgroundColor='#ff6b00'">
                                        Añadir reseña
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

<div id="popup-recomendacion" style="display:none; position:fixed; top:20px; left:50%; transform:translateX(-50%);
     background:#eef; padding:15px; border-radius:8px; z-index:1000;"></div>


<script src="~/js/calificar.js"></script>