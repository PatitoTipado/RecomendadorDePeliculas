@model IEnumerable<RecomendadorDePeliculas.Entidades.Models.Pelicula>


<div class="container mt-3 mb-4 text-end">
    <a class="btn btn-outline-secondary" asp-action="Historial" asp-controller="Home">Ver mi historial</a>
    <a href="@Url.Action("Generos", "Home")" class="btn btn-outline-primary">
        Modificar géneros favoritos
    </a>
</div>

<div class="container mt-4">
    
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var pelicula in Model)
            {
            <div class="col">
                    <div class="card h-100 shadow-sm">
                        <div class="row g-0">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-8">
                                <div class="card-body">
                                    <h5 class="card-title">@pelicula.Title </h5>
                                    <p class="card-text"><strong>Géneros:</strong> @pelicula.Genres</p>
                                    <p class="card-text"><strong>ID Interno:</strong> @pelicula.Id</p>
                                    <p class="card-text"><strong>TMDB ID:</strong> @pelicula.TmdbId</p>
                                <button class="btn btn-sm btn-outline-success mt-2" onclick="obtenerRecomendacion(@pelicula.Id,'@pelicula.Title','@pelicula.Genres')">¿Es para mí?</button>
                                <a asp-controller="Home"
                                   asp-action="Resenar"
                                   asp-all-route-data="@(new Dictionary<string, string> { ["id"] = pelicula.Id.ToString() })"
                                   class="btn btn-sm btn-outline-info mt-2">
                                    Añadir reseña
                                </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
</div>

<div id="popup-recomendacion" style="display:none; position:fixed; top:20px; left:50%; transform:translateX(-50%);
     background:#eef; padding:15px; border-radius:8px; z-index:1000;"></div>


<script src="~/js/calificar.js"></script>