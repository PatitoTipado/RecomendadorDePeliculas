@model IEnumerable<RecomendadorDePeliculas.Entidades.DTOS.HistorialConInfoDTO>

<div class="container mt-5">
    <h2 class="fw-bold mb-4" style="color: #ff6b00;">
        <i class="bi bi-clock-history"></i> Mi Historial de Reseñas
    </h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">Todavía no has hecho ninguna reseña.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm" style="border-radius: 12px;">
                        <div class="row g-0">
                            <div class="col-md-4">
                                <img src="@item.ImagenUrl" class="img-fluid rounded-start h-100" alt="Póster de @item.Titulo" style="object-fit: cover;" />
                            </div>
                            <div class="col-md-8">
                                <div class="card-body d-flex flex-column justify-content-between h-100">
                                    <div>
                                        <h5 class="card-title mb-2">@item.Titulo</h5>
                                        <p class="card-text mb-1"><strong>Géneros:</strong> @item.Generos</p>
                                        <p class="card-text mb-1"><strong>Calificación:</strong> @item.Calificacion</p>
                                        <p class="card-text mb-2"><strong>Comentario:</strong> @item.Comentario</p>
                                        <p class="card-text"><small class="text-muted">Fecha: @item.FechaResena.ToString("dd/MM/yyyy")</small></p>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2 mt-3">
                                        <a href="@Url.Action("Resenar", "Home", new { id = item.PeliculaId })"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                        <form method="post" asp-action="EliminarResena">
                                            <input type="hidden" name="peliculaId" value="@item.PeliculaId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Borrar
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="text-center mt-4">
        <a class="btn btn-outline-secondary" href="@Url.Action("CalificarPeliculas", "Home")">
            ← Volver al inicio
        </a>
    </div>
</div>
