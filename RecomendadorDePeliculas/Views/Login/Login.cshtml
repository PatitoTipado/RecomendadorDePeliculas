@{
    //Layout = null; // Para que no use ningún layout
    ViewData["Title"] = "Iniciar sesion";
}

@if (TempData["aviso"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mt-3 mx-auto text-center" role="alert" style="max-width: 500px;">
        @TempData["aviso"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="container mt-5">
    <div class="mx-auto p-4 bg-white shadow-sm" style="max-width: 480px; border-radius: 16px;">
        <h2 class="fw-bold mb-4 text-center" style="color: #ff6b00;">
            <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
        </h2>

        <form asp-action="ValidarLogin" method="post">
            <div class="mb-3">
                <label for="correo" class="form-label fw-semibold">Correo</label>
                <input type="email" class="form-control rounded-3" id="correo" name="correo" placeholder="ejemplo@correo.com" required />
            </div>

            <div class="mb-3">
                <label for="contrasenia" class="form-label fw-semibold">Contraseña</label>
                <input type="password" class="form-control rounded-3" id="contrasenia" name="contrasenia" placeholder="Tu contraseña" required />
            </div>

            @if (TempData["Mensaje"] != null)
            {
                <div class="alert alert-danger text-center py-2">
                    @TempData["Mensaje"]
                </div>
            }

            <div class="d-grid mt-4">
                <button type="submit"
                        class="btn text-white fw-bold"
                        style="background-color: #ff6b00; border-radius: 8px; transition: background-color 0.3s ease;"
                        onmouseover="this.style.backgroundColor='#e65c00'"
                        onmouseout="this.style.backgroundColor='#ff6b00'">
                    Iniciar Sesión
                </button>
            </div>

            <div class="mt-3 text-end">
                <a href="/Login/RecuperarContrasenia" class="text-decoration-none">
                    ¿Olvidaste tu contraseña?
                </a>
            </div>
        </form>
    </div>
</div>