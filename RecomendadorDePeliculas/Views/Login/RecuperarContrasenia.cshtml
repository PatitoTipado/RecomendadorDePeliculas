@{
    ViewData["Title"] = "Recuperar contraseña";
}

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show mt-3 mx-auto text-center" role="alert" style="max-width: 500px;">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="container mt-5">
    <div class="mx-auto p-4 bg-white shadow-sm" style="max-width: 480px; border-radius: 16px;">
        <h2 class="fw-bold mb-4 text-center" style="color: #ff6b00;">
            <i class="bi bi-envelope-lock me-1"></i> Recuperar Contraseña
        </h2>

        <form method="post" asp-action="RecuperarContrasenia">
            <div class="mb-3">
                <label for="correo" class="form-label fw-semibold">Correo electrónico</label>
                <input type="email" name="correo" id="correo" class="form-control rounded-3" placeholder="ejemplo@correo.com" required />
            </div>

            <div class="d-grid mt-4">
                <button type="submit"
                        class="btn text-white fw-bold"
                        style="background-color: #ff6b00; border-radius: 8px; transition: background-color 0.3s ease;"
                        onmouseover="this.style.backgroundColor='#e65c00'"
                        onmouseout="this.style.backgroundColor='#ff6b00'">
                    Enviar enlace de recuperación
                </button>
            </div>

            <div class="mt-3 text-center">
                <a href="/Login" class="text-decoration-none text-primary">
                    ← Volver al inicio de sesión
                </a>
            </div>
        </form>
    </div>
</div>