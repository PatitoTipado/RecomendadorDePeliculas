@{
    ViewData["Title"] = "Registro";
    ViewData["NavContext"] = "registro";
}

@model RecomendadorDePeliculas.Entidades.Models.Usuario
<div class="container mt-5">
    <div class="mx-auto p-4 bg-white shadow-sm" style="max-width: 480px; border-radius: 16px;">
        <h2 class="fw-bold mb-4 text-center" style="color: #ff6b00;">
            <i class="bi bi-person-plus-fill me-1"></i> Registro de Usuario
        </h2>

        <form asp-action="Registrar" method="post">
            <div class="mb-3">
                <label asp-for="Correo" class="form-label fw-semibold"></label>
                <input asp-for="Correo" type="email" class="form-control rounded-3" placeholder="ejemplo@correo.com" required />
                <span asp-validation-for="Correo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FechaDeNacimiento" class="form-label fw-semibold"></label>
                <input asp-for="FechaDeNacimiento" type="date" class="form-control rounded-3" />
                <span asp-validation-for="FechaDeNacimiento" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ContraseniaHash" class="form-label fw-semibold">Contraseña</label>
                <input asp-for="ContraseniaHash" type="password" class="form-control rounded-3" placeholder="Contraseña" />
                <span asp-validation-for="ContraseniaHash" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label for="RepetirContrasenia" class="form-label fw-semibold">Repetir Contraseña</label>
                <input id="RepetirContrasenia" name="rcontra" type="password" class="form-control rounded-3" placeholder="Repite la contraseña" required />
                @if (TempData["rcontra"] != null)
                {
                    <div class="text-danger">@TempData["rcontra"]</div>
                }
            </div>

            <div class="mb-3">
                <label asp-for="Genero" class="form-label fw-semibold"></label>
                <select asp-for="Genero" class="form-select rounded-3">
                    <option value="">Seleccionar</option>
                    <option value="M">Masculino</option>
                    <option value="F">Femenino</option>
                    <option value="O">Otro</option>
                </select>
                <span asp-validation-for="Genero" class="text-danger"></span>
            </div>

            <div class="d-grid mt-4">
                <button type="submit"
                        class="btn text-white fw-bold"
                        style="background-color: #ff6b00; border-radius: 8px; transition: background-color 0.3s ease;"
                        onmouseover="this.style.backgroundColor='#e65c00'"
                        onmouseout="this.style.backgroundColor='#ff6b00'">
                    Registrarse
                </button>
            </div>

            <div class="mt-3 text-center">
                <a href="/Login" class="text-decoration-none text-primary">
                    ¿Ya tenés cuenta? Iniciá sesión
                </a>
            </div>
        </form>
    </div>
</div>
