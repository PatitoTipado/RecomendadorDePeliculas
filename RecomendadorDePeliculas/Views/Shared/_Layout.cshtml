@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RecomendadorDePeliculas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RecomendadorDePeliculas.styles.css" asp-append-version="true" />

</head>
<body class="d-flex flex-column bg-light">

    @{
        string urlDestino;

        if (User.Identity.IsAuthenticated)
        {
            urlDestino = Url.Action("CalificarPeliculas", "Home");
        }
        else
        {
            urlDestino = Url.Action("Login", "login");
        }
}
    <header class="d-flex justify-content-between align-items-center p-3 shadow bg-white">
        <a href="@urlDestino" class="logo-header text-decoration-none text-dark fw-bold fs-4"></a>

        @{
            var usuarioLogueado = HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated ?? false;
        }

        @if (!usuarioLogueado)
        {
            if (ViewData["NavContext"]?.ToString() == "registro")
            {
                <a href="/Login/Login" class="btn btn-outline-secondary">Iniciar Sesión</a>
            }
            else
            {
                <a href="/Login/Registrar" class="btn btn-outline-primary">Registrarse</a>
            }
        }
        else
        {
            <span class="me-3">¡Hola, @User.Identity.Name!</span>

            <div>
                <a asp-controller="Usuario" asp-action="Editar" class="btn btn-warning">
                    Editar Perfil
                </a>
                <a href="/Login/Logout" class="btn btn-outline-danger">Cerrar sesión</a>
            </div>
        }
    </header>

    <main>
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
